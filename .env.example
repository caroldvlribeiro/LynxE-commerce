REDIS_URL=redis://default:replace-with-your-password@your-redis-cloud-host:port
REDIS_KEY_PREFIX=ecommerce
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false

# Alternatively, provide Redis Cloud's connection fields instead:
# REDIS_HOST=your-redis-cloud-host
# REDIS_PORT=your-redis-cloud-port
# REDIS_USERNAME=default
# REDIS_PASSWORD=replace-with-your-password
